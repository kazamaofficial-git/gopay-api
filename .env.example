# Port server. Di cPanel biarkan bawaan.
PORT=3000

# Kunci rahasia untuk endpoint backend. Buat yang panjang dan acak.
API_KEY=YOUR_API_KEY_HERE

# Isi QRIS statis dari aplikasi GoBiz (diawali 000201).
QRIS_STATIC=YOUR_QRIS_STATIC_HERE

# ID merchant GoBiz (disarankan).
GOPAY_MERCHANT_ID=

# Opsional: alamat publik untuk membentuk qris_url, contoh https://api.tokomu.id
PUBLIC_BASE_URL=

# Opsional: jumlah proxy di depan server (Nginx = 1).
TRUST_PROXY=1

# Opsional: lokasi file sesi login GoBiz.
# SESSION_FILE=./.GOPAY_SESI_JANGAN_DIHAPUS.json

# Opsional: override endpoint Gojek bila berubah.
# GOJEK_AUTH_URL=https://accounts.goto-products.com
# GOJEK_CLIENT_ID=go-biz-web-new
# GOJEK_TRANSACTIONS_URL=https://api.gojekapi.com/merchant-analytics/v2/merchants/transactions
